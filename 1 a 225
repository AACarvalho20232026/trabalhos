#include <iostream>
#include <iomanip> // Para usar setw

using namespace std;

int main() {
    const int LINHAS = 15;
    const int COLUNAS = 15;
    int numero = 1;

    for (int a = 0; a < LINHAS; a++) {
        for (int b = 0; b < COLUNAS; b++) {
            cout << setw(4) << numero++; // setw define largura fixa para alinhamento
        }
        cout << endl; 
    }

    return 0;
}
